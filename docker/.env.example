# ============================================
# 莲花书院 — 部署环境变量
# 复制此文件为 .env 并修改为实际值
# ============================================

# ---- 站点配置 ----
# 对外访问的站点 URL（Nginx 入口）
SITE_URL=http://localhost
# Supabase API 对外 URL（通过 Nginx 代理）
API_EXTERNAL_URL=http://localhost/api
SUPABASE_PUBLIC_URL=http://localhost/api
# 前端构建时使用的 Supabase URL（会被内联到客户端 JS 中）
NEXT_PUBLIC_SUPABASE_URL=http://localhost/api

# ---- Nginx 端口 ----
NGINX_PORT=80

# ---- Supabase Studio 端口（可选，管理面板） ----
STUDIO_PORT=3002

# ---- 数据库 ----
POSTGRES_PASSWORD=your-super-secret-password

# ---- JWT 密钥（至少 32 字符） ----
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

# ---- Supabase API 密钥 ----
# 匿名密钥（前端使用）
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRFA0NiK7ACcPzu4FiJiIae3ViBtae5oPOMuZahNDjE
# 服务端密钥（仅后端使用，切勿暴露给前端）
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hj04zWl196z2-SBc0

# ---- 邮箱注册配置 ----
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
DISABLE_SIGNUP=false

# ---- SMTP 邮件配置（可选，用于邮箱验证） ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=莲花书院

# ---- Realtime ----
SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq

# ---- 其他 ----
ADDITIONAL_REDIRECT_URLS=
IMGPROXY_ENABLE_WEBP_DETECTION=true
STUDIO_DEFAULT_ORGANIZATION=莲花书院
STUDIO_DEFAULT_PROJECT=lotus-academy
